import logging
from typing import Annotated, Any

from agent_framework import Agent, tool
{% if has_mcp_tools %}from agent_framework import MCPStreamableHTTPTool
{% endif %}
logger = logging.getLogger(__name__)

AGENT_NAME = "{{ agent_name }}"
INSTRUCTIONS = """{{ instructions }}"""

{% for t in function_tools %}

@tool
async def {{ t.safe_name }}(
{% for p in t.py_params %}    {{ p.name }}: Annotated[{{ p.annotation }}, "{{ p.description | replace('"', '\\"') }}"]{% if not p.required %} = None{% endif %},
{% endfor %}) -> dict[str, Any]:
    """{{ t.description }}"""
    # TODO: Implement the "{{ t.name }}" tool.
    logger.warning("Tool '{{ t.name }}' is not implemented yet")
    return {"status": "todo", "tool": "{{ t.name }}"}
{% endfor %}


def {{ factory }}(client) -> Agent:
    """Create the "{{ agent_name }}" agent bound to the given chat client."""
    tools: list[Any] = [
{% for t in function_tools %}        {{ t.safe_name }},
{% endfor %}    ]
{% if has_mcp_tools %}
    # Hosted MCP / knowledge-base tools.
    tools.extend([
{% for m in mcp_tools %}        MCPStreamableHTTPTool(
            name="{{ m.safe_name }}",
            url="{{ m.server_url }}",
        ),
{% endfor %}    ])
{% endif %}
    return Agent(
        client=client,
        name=AGENT_NAME,
        description={{ agent_description | tojson }},
        instructions=INSTRUCTIONS,
        tools=tools,
    )

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ agent_slug }}"
version = "{{ agent_version }}"
description = "{{ agent_description }}"
readme = "README.md"
requires-python = ">=3.11"
license = {text = "MIT"}
authors = [
    {name = "Your Name", email = "your.email@example.com"},
]
keywords = ["agent", "foundry", "ai"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
]

dependencies = [
    "agent-framework-core~=1.8.0",
    "azure-identity>=1.14.0",
    "azure-ai-projects>=1.0.0",
    "pydantic>=2.0.0",
    "pydantic-settings>=2.0.0",
    "aiohttp>=3.9.0",
    "httpx>=0.25.0",
    "PyYAML>=6.0",
    "python-json-logger>=2.0.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "pytest-asyncio>=0.21.0",
    "pytest-cov>=4.1.0",
    "black>=23.0.0",
    "mypy>=1.5.0",
    "ruff>=0.1.0",
    "isort>=5.12.0",
]
observability = [
    "azure-monitor-opentelemetry>=1.0.0",
    "opentelemetry-exporter-jaeger>=1.20.0",
]

[project.urls]
Homepage = "https://github.com/yourusername/{{ agent_slug }}"
Documentation = "https://github.com/yourusername/{{ agent_slug }}/blob/main/README.md"
Repository = "https://github.com/yourusername/{{ agent_slug }}"

[tool.pytest.ini_options]
minversion = "7.0"
testpaths = ["tests"]
asyncio_mode = "auto"
addopts = [
    "-ra",
    "--strict-markers",
    "--strict-config",
    "--cov=src",
    "--cov-report=term-missing",
]

[tool.black]
line-length = 100
target-version = ["py311", "py312"]

[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = false
ignore_missing_imports = true

[tool.ruff]
line-length = 100
target-version = "py311"
select = ["E", "F", "W", "I"]

[tool.isort]
profile = "black"
line_length = 100

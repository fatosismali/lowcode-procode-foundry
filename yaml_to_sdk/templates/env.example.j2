# =====================================================================
# {{ agent_name | upper }} - FOUNDRY CONFIGURATION
# =====================================================================
# Rename this file to .env and fill in your actual values
# Never commit .env to version control!

# =====================================================================
# FOUNDRY CONFIGURATION (Required)
# =====================================================================

# Your Foundry project connection string
# Format: https://<region>.api.cognitive.microsoft.com/projects/<project-id>
FOUNDRY_PROJECT_CONNECTION_STRING=your-foundry-project-connection-string-here

# =====================================================================
# MODEL CONFIGURATION
# =====================================================================

# Model to use (gpt-5, gpt-4, etc.)
MODEL_NAME={{ model }}

# Reasoning effort (low, medium, high)
# Note: Only available with specific models
REASONING_EFFORT={{ reasoning_effort }}

# =====================================================================
# LOGGING CONFIGURATION
# =====================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =====================================================================
# TOOL CONFIGURATION
# =====================================================================

# Enable/disable individual tools
{% for tool in function_tools %}
ENABLE_{{ tool.safe_name | upper }}=true
{% endfor %}

# Tool execution settings
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=10

# =====================================================================
# MCP SERVER CONFIGURATION
# =====================================================================

{% for mcp_tool in mcp_tools %}
# {{ mcp_tool.name }}
{{ mcp_tool.safe_name | upper }}_URL={{ mcp_tool.server_url }}
{{ mcp_tool.safe_name | upper }}_CONNECTION_ID={{ mcp_tool.project_connection_id }}

{% endfor %}

# =====================================================================
# AZURE CREDENTIALS
# =====================================================================

# Azure credentials (uses DefaultAzureCredential if not set)
# Options:
# 1. Leave blank to use DefaultAzureCredential (recommended for dev)
# 2. Set AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET for service principal
# 3. Set AZURE_SUBSCRIPTION_ID for subscription-based auth

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# =====================================================================
# RUNTIME CONFIGURATION
# =====================================================================

# Environment name (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=false

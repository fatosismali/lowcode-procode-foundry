import asyncio
import logging
from typing import Optional
from azure.identity import DefaultAzureCredential

from agent_framework import Agent, Tool, FoundryChatClient
from agent_framework.foundry import FoundryModelClient

from .config import AgentConfig
from .models import *

logger = logging.getLogger(__name__)


class {{ agent_class }}:
    """
    {{ agent_description }}
    
    Model: {{ model }}
    Tools: {{ total_tools }}
    """
    
    def __init__(self, config: Optional[AgentConfig] = None):
        """Initialize the agent with configuration."""
        self.config = config or AgentConfig.from_env()
        self._agent: Optional[Agent] = None
        self._initialize_agent()
    
    def _initialize_agent(self):
        """Initialize the Agent Framework agent."""
        # Create model client
        credential = DefaultAzureCredential()
        model_client = FoundryModelClient(
            connection_string=self.config.foundry_project_connection_string,
            model=self.config.model_name,
            reasoning_effort=self.config.reasoning_effort,
            credential=credential,
        )
        
        # Create agent
        self._agent = Agent(
            name="{{ agent_class }}",
            instructions=self._get_system_prompt(),
            model_client=model_client,
        )
        
        # Create and bind tools
        self._create_tools()
    
    def _get_system_prompt(self) -> str:
        """Get the system prompt from YAML definition."""
        return """{{ instructions }}"""
    
    def _create_tools(self):
        """Create and bind all tools to the agent."""
        {% for tool in function_tools %}
        @Tool(name="{{ tool.name }}", description="{{ tool.description }}")
        async def {{ tool.safe_name }}_tool({% if tool.parameters and tool.parameters.properties %}{% for param_name in tool.parameters.properties %}{{ param_name }}: str, {% endfor %}{% endif %}) -> dict:
            """Tool: {{ tool.name }}"""
            try:
                result = await self._execute_{{ tool.safe_name }}(
                    {% if tool.parameters and tool.parameters.properties %}{% for param_name in tool.parameters.properties %}{{ param_name }}={{ param_name }},
                    {% endfor %}{% endif %}
                )
                return result
            except Exception as e:
                logger.error(f"Error in {{ tool.name }}: {e}", exc_info=True)
                return {"status": "error", "error": str(e)}
        
        self._agent.register_tool({{ tool.safe_name }}_tool)
        {% endfor %}
    
    # ====== Tool Implementations ======
    # Edit these methods to implement your tool logic
    
    {% for tool in function_tools %}
    async def _execute_{{ tool.safe_name }}(self, {% if tool.parameters and tool.parameters.properties %}{% for param_name in tool.parameters.properties %}{{ param_name }}: str = None, {% endfor %}{% endif %}) -> dict:
        """
        Implementation for: {{ tool.name }}
        
        Description: {{ tool.description }}
        {% if tool.parameters and tool.parameters.properties %}
        Parameters:
        {% for param_name in tool.parameters.properties %}
            - {{ param_name }}: {{ tool.parameters.properties[param_name].get('type', 'string') }}
        {% endfor %}
        {% endif %}
        """
        # TODO: Implement this tool
        logger.warning(f"{{ tool.name }} tool not yet implemented")
        return {
            "status": "todo",
            "message": "Tool implementation pending",
            "tool": "{{ tool.name }}",
        }
    
    {% endfor %}
    
    # ====== Conversation Methods ======
    
    async def run_conversation(self, user_message: str) -> str:
        """
        Run a single conversation turn.
        
        Args:
            user_message: User input message
            
        Returns:
            Agent response text
        """
        if not self._agent:
            raise RuntimeError("Agent not initialized")
        
        try:
            # Invoke agent
            response = await self._agent.invoke(user_message)
            
            # Extract response text
            if hasattr(response, 'messages') and response.messages:
                # Get last message from agent
                for msg in reversed(response.messages):
                    if hasattr(msg, 'content') and msg.content:
                        return msg.content
            
            return str(response)
            
        except Exception as e:
            logger.error(f"Error in conversation: {e}", exc_info=True)
            raise
    
    async def run_interactive(self):
        """Run interactive conversation loop."""
        logger.info("Starting interactive conversation (type 'exit' to quit)")
        logger.info("-" * 70)
        
        while True:
            try:
                user_input = input("\n🧑 You: ").strip()
                
                if user_input.lower() in ("exit", "quit"):
                    logger.info("\n👋 Goodbye!")
                    break
                
                if not user_input:
                    continue
                
                logger.info("\n🤖 Agent: ", end="")
                response = await self.run_conversation(user_input)
                logger.info(response)
                
            except KeyboardInterrupt:
                logger.info("\n\n👋 Interrupted. Goodbye!")
                break
            except Exception as e:
                logger.error(f"Error: {e}")


async def main():
    """Main entry point."""
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    )
    
    logger.info("Starting {{ agent_class }}...")
    
    try:
        agent = {{ agent_class }}()
        await agent.run_interactive()
    except KeyboardInterrupt:
        logger.info("Interrupted by user")
    except Exception as e:
        logger.error(f"Fatal error: {e}", exc_info=True)
        exit(1)


if __name__ == "__main__":
    asyncio.run(main())

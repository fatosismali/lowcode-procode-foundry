class TestConversation:
    """Test agent conversation capabilities."""

    @pytest.mark.asyncio
    async def test_single_turn_conversation(self, agent):
        """Test single conversation turn."""
        user_message = "What is the status?"
        
        with patch.object(agent, 'run_conversation', new_callable=AsyncMock) as mock_run:
            mock_run.return_value = "Agent response"
            
            response = await mock_run(user_message)
            assert response == "Agent response"
            mock_run.assert_called_once_with(user_message)

    @pytest.mark.asyncio
    async def test_conversation_with_tools(self, agent):
        """Test conversation with tool invocation."""
        user_message = "Get incident details"
        
        with patch.object(agent, 'run_conversation', new_callable=AsyncMock) as mock_run:
            mock_run.return_value = "Incident details: ..."
            
            response = await mock_run(user_message)
            assert "Incident" in response


class TestConfiguration:
    """Test configuration loading and validation."""

    def test_config_from_dict(self, mock_config):
        """Test configuration from dictionary."""
        assert mock_config.foundry_project_connection_string is not None
        assert mock_config.model_name == "{{model}}"
        assert mock_config.reasoning_effort == "{{reasoning_effort}}"

    def test_config_get_enabled_tools(self, mock_config):
        """Test getting enabled tools list."""
        enabled_tools = mock_config.get_enabled_tools()
        assert isinstance(enabled_tools, list)
        assert len(enabled_tools) > 0

    def test_config_repr(self, mock_config):
        """Test config string representation."""
        config_str = repr(mock_config)
        assert "AgentConfig" in config_str
        assert "{{model}}" in config_str



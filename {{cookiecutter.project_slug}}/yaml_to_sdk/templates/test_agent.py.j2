        request = {{tool.class_name}}Request(
{%- for param in tool.required_params %}
            {{param}}="test_value",
{%- endfor %}
        )
        
        # Mock tool execution with error
        with patch.object(agent, '_execute_{{tool.safe_name}}', new_callable=AsyncMock) as mock_tool:
            mock_tool.side_effect = Exception("Tool error")
            

    if sys.stdin.isatty():
        await agent.run_interactive()
    else:
        # Single message mode
        import sys
        message = sys.argv[1] if len(sys.argv) > 1 else "Hello"
        response = await agent.run_conversation(message)
        print(response)


if __name__ == "__main__":
    asyncio.run(main())

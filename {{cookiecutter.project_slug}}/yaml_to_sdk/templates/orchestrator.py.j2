    async def run_conversation(self, user_message: str) -> str:
        """
        Run a single conversation turn with the agent.
        
        Args:
            user_message: User input message
            
        Returns:
            Agent response
        """
        agent = await self._initialize_agent()
        self.logger.info(f"Processing user message: {user_message}")

        try:
            # Create chat message
            messages = [ChatMessage(
                role=ChatMessageRoleType.USER,
                content=user_message
            )]

            # Invoke agent
            response = await agent.invoke(messages=messages)
            
            # Extract response text
            if response and response.messages:
                last_message = response.messages[-1]
                if hasattr(last_message, 'content'):
                    return last_message.content
            
            return "No response from agent"
        
        except Exception as e:
            self.logger.error(f"Conversation failed: {e}", exc_info=True)
            raise

    async def run_interactive(self):
        """Run interactive conversation loop."""
        print(f"\n{{agent_name}} Agent Interactive Mode")
        print("Type 'quit' or 'exit' to stop\n")

        try:
            agent = await self._initialize_agent()
            
            while True:
                try:
                    user_input = input("You: ").strip()
                    
                    if user_input.lower() in {"quit", "exit"}:
                        print("Goodbye!")
                        break
                    
                    if not user_input:
                        continue
                    
                    response = await self.run_conversation(user_input)
                    print(f"Agent: {response}\n")
                
                except KeyboardInterrupt:
                    print("\nInterrupted. Type 'quit' to exit.")
                    continue
        
        except Exception as e:
            self.logger.error(f"Interactive mode failed: {e}", exc_info=True)
            raise
        finally:
            if self._client:
                await self._client.close()


async def main():

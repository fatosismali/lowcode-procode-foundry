# {{agent_name}} Agent - Environment Configuration

# ==============================================================================
# Required: Foundry Project Connection
# ==============================================================================
# Get this from Azure Portal > Your AI Foundry Resource > Project Details
FOUNDRY_PROJECT_CONNECTION_STRING=<your-foundry-project-connection-string>

# ==============================================================================
# Model Configuration
# ==============================================================================
# Model to use for the agent
MODEL_NAME={{model}}

# Optional: Azure OpenAI Deployment ID (if using specific deployment)
MODEL_DEPLOYMENT_ID=

# Optional: Custom model endpoint (for cross-resource invocation via APIM)
MODEL_ENDPOINT=

# ==============================================================================
# Agent Configuration
# ==============================================================================
# Reasoning effort level: low, medium, high
REASONING_EFFORT={{reasoning_effort}}

# ==============================================================================
# Tool Configuration
# ==============================================================================
{%- for tool in function_tools %}
# Enable/disable {{tool.name}} tool
{{tool.safe_name|upper}}_ENABLED=true
{%- endfor %}

{%- if has_mcp_tools %}
# ==============================================================================
# MCP Server Configuration
# ==============================================================================
{%- for mcp_tool in mcp_tools %}
# {{mcp_tool.server_label}} MCP Server
{{mcp_tool.safe_label|upper}}_URL={{mcp_tool.server_url}}
{{mcp_tool.safe_label|upper}}_PROJECT_CONNECTION_ID={{mcp_tool.project_connection_id}}
{%- endfor %}

{%- endif %}

# ==============================================================================
# Logging and Observability
# ==============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable OpenTelemetry tracing for observability
ENABLE_TRACING=false

# Optional: Application Insights connection string (for distributed tracing)
APPINSIGHTS_CONNECTION_STRING=

# ==============================================================================
# Agent Identity (for hosted agent RBAC)
# ==============================================================================
{%- if instance_principal_id %}
AGENT_PRINCIPAL_ID={{instance_principal_id}}
{%- endif %}

{%- if instance_client_id %}
AGENT_CLIENT_ID={{instance_client_id}}
{%- endif %}

# ==============================================================================
# Runtime Configuration
# ==============================================================================
# Timeout for individual tool execution (seconds)
TOOL_TIMEOUT_SECONDS=30

# Timeout for complete conversation turn (seconds)
CONVERSATION_TIMEOUT_SECONDS=300

# Maximum number of tool calls per conversation turn
MAX_TOOL_CALLS=10

# ==============================================================================
# Azure Credentials (for local development)
# ==============================================================================
# Leave empty to use DefaultAzureCredential (recommended)
# Supports: subscription ID, tenant ID environment variables
# See: https://learn.microsoft.com/en-us/python/api/azure-identity/azure.identity.defaultazurecredential
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# ==============================================================================
# Development Settings
# ==============================================================================
# Set to 'true' for development/testing
DEBUG=false

# Set to 'true' to mock tool responses without calling actual services
USE_MOCK_TOOLS=false

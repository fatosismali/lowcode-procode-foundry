# =====================================================================
# VF-TRIAGE-TOOL-AGENT - FOUNDRY CONFIGURATION
# =====================================================================
# Rename this file to .env and fill in your actual values
# Never commit .env to version control!

# =====================================================================
# FOUNDRY CONFIGURATION (Required)
# =====================================================================

# Your Foundry project connection string
# Format: https://<region>.api.cognitive.microsoft.com/projects/<project-id>
FOUNDRY_PROJECT_CONNECTION_STRING=your-foundry-project-connection-string-here

# =====================================================================
# MODEL CONFIGURATION
# =====================================================================

# Model to use (gpt-5, gpt-4, etc.)
MODEL_NAME=gpt-5

# Reasoning effort (low, medium, high)
# Note: Only available with specific models
REASONING_EFFORT=low

# =====================================================================
# LOGGING CONFIGURATION
# =====================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =====================================================================
# TOOL CONFIGURATION
# =====================================================================

# Enable/disable individual tools
ENABLE_GET_INCIDENT=true
ENABLE_FETCH_TELEMETRY=true
ENABLE_FETCH_CUSTOMER_IMPACT=true
ENABLE_APPLY_CHANGE=true

# Tool execution settings
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=10

# =====================================================================
# MCP SERVER CONFIGURATION
# =====================================================================

# kb_regulationpolciies_ziw96
KB_REGULATIONPOLCIIES_ZIW96_URL=https://msagthack-search-mzloe6z4nnwoc.search.windows.net/knowledgebases/regulationpolciies/mcp?api-version=2025-11-01-Preview
KB_REGULATIONPOLCIIES_ZIW96_CONNECTION_ID=kb-regulationpolciies-ziw96


# =====================================================================
# AZURE CREDENTIALS
# =====================================================================

# Azure credentials (uses DefaultAzureCredential if not set)
# Options:
# 1. Leave blank to use DefaultAzureCredential (recommended for dev)
# 2. Set AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET for service principal
# 3. Set AZURE_SUBSCRIPTION_ID for subscription-based auth

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# =====================================================================
# RUNTIME CONFIGURATION
# =====================================================================

# Environment name (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=false
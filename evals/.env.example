# Copy to evals/.env and point at YOUR team's Foundry project.
# Each team on simulation day has its own project.

FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment used as the LLM judge. Reasoning deployments (o-series,
# gpt-5) are detected automatically and get is_reasoning_model=True. A
# non-reasoning judge such as gpt-4.1 is cheaper and more predictable if you
# have one deployed.
EVAL_JUDGE_DEPLOYMENT=gpt-5-mini

# Optional. Derived from FOUNDRY_PROJECT_ENDPOINT when left blank.
# AZURE_OPENAI_ENDPOINT=https://<account>.services.ai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

# Optional. Leave blank to authenticate with az login (recommended).
# AZURE_OPENAI_API_KEY=

# Optional. Defaults to generated_agents/vf_billing_team.
# EVAL_TEAM_DIR=../generated_agents/vf_billing_team
